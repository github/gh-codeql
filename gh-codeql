#!/usr/bin/env bash
set -Eeuo pipefail
# Safer word-splitting: do NOT split on spaces; only on newline/tab.
IFS=$'\n\t'

# -------- logging & exits --------
log()  { printf '%s\n' "$*"; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }
die()  { local code="${1:-1}"; shift || true; printf 'ERROR: %s\n' "$*" >&2; exit "$code"; }

# -------- debug flag --------
debug="$(gh config get extensions.codeql.debug 2>/dev/null || true)"
if [[ "${debug:-}" == "true" ]]; then set -x; fi

# -------- resolve script root --------
# Robust when invoked via gh extension wrapper or symlink.
script_path="${BASH_SOURCE[0]:-$0}"
rootdir="$(cd -- "$(dirname -- "$script_path")" && pwd -P)"

# -------- dependency checks --------
for cmd in gh curl unzip; do
  command -v "$cmd" >/dev/null 2>&1 || die 127 "Missing dependency '$cmd'. Please install it and try again."
done

# -------- write permission guard --------
tmp="$rootdir/.gh-codeql.$$"
if ! (umask 077 && : >"$tmp") 2>/dev/null; then
  die 13 "No write permission in '$rootdir'. Run with sufficient permissions or choose a writable location."
fi
rm -f "$tmp" || true

# -------- config --------
channel="$(gh config get extensions.codeql.channel 2>/dev/null || true)"
version="$(gh config get extensions.codeql.version 2>/dev/null || true)"
local_version="$(gh config get extensions.codeql.local-version 2>/dev/null || true)"

usage() {
  cat <<EOF
GitHub command-line wrapper for the CodeQL CLI.

Usage:
    gh codeql set-channel [release|nightly]     # default: release
    gh codeql set-version [version]             # default: latest
    gh codeql local-version [on|off]            # enable/disable local version support
    gh codeql set-local-version [version]       # pin version in current working directory (default: latest)
    gh codeql unset-local-version               # switch back to the global version
    gh codeql list-versions                     # list available versions for current channel
    gh codeql list-installed                    # list installed versions for current channel
    gh codeql cleanup <version>                 # delete a specific downloaded version
    gh codeql cleanup-all                       # delete all installed versions for all channels
    gh codeql download [version]                # download a specific version (default: latest)
    gh codeql debug [on|off]                    # enable/disable debug output for the extension
    gh codeql install-stub [dir]                # install 'codeql' stub that invokes 'gh codeql' (default: /usr/local/bin/)
    gh codeql <anything else>                   # pass arguments to CodeQL CLI

Current channel: ${channel:-not specified}.
Current version: ${version:-not specified}.
EOF
}

# -------- top-level flags / help --------
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || -z "${1:-}" ]]; then
  usage
  exit 0
fi

if [[ "${1:-}" == "debug" ]]; then
  case "${2:-}" in
    on)  gh config set extensions.codeql.debug true  2>/dev/null ;;
    off) gh config set extensions.codeql.debug false 2>/dev/null ;;
    *)   die 2 "Invalid debug command: '${2:-}'. Use 'on' or 'off'." ;;
  esac
  exit 0
fi

# -------- channel / repo --------
if [[ -z "${channel:-}" || "$channel" == "release" ]]; then
  channel="release"
  repo="github/codeql-cli-binaries"
elif [[ "$channel" == "nightly" ]]; then
  repo="dsp-testing/codeql-cli-nightlies"
else
  die 2 "Channel must be 'release' or 'nightly'."
fi

# -------- platform detection --------
platform="$(gh config get extensions.codeql.platform 2>/dev/null || true)"
if [[ -z "${platform:-}" ]]; then
  case "${OSTYPE:-}" in
    darwin*)                platform="osx64"  ;;
    linux*)                 platform="linux64";;
    cygwin*|msys*|win*)     platform="win64"  ;;
    *) die 2 "Couldn't determine platform from OSTYPE='${OSTYPE:-}'. Set 'extensions.codeql.platform'." ;;
  esac
fi

# -------- local-version toggle --------
if [[ "${1:-}" == "local-version" ]]; then
  case "${2:-}" in
    on)
      warn "Local version support enables reading '.codeql-version'. Use only in trusted repositories."
      gh config set extensions.codeql.local-version true 2>/dev/null
      ;;
    off)
      gh config set extensions.codeql.local-version false 2>/dev/null
      ;;
    *)
      die 2 "Invalid local-version command: '${2:-}'. Use 'on' or 'off'."
      ;;
  esac
  exit 0
fi

# Honor .codeql-version only if local-version is enabled
if [[ -e ".codeql-version" ]]; then
  if [[ "${local_version:-}" == "true" ]]; then
    version="$(< .codeql-version)"
  else
    warn "Ignoring .codeql-version because local version support is disabled. Enable with: gh codeql local-version on"
  fi
fi

# Allow env override
version="${GH_CODEQL_VERSION:-${version:-}}"

# -------- helpers --------
get_latest() {
  if [[ "$channel" == "release" ]]; then
    gh api "repos/$repo/releases" --paginate \
      --jq '.[] | select(.draft==false and .prerelease==false) | .tag_name' | sort -V | tail -1
  else
    gh api "repos/$repo/releases" --jq '.[] | select(.draft==false) | .tag_name' | head -1
  fi
}

validate_version() {
  local want="${1:-}"
  local out=""
  if [[ -z "$want" || "$want" == "latest" ]]; then
    out="$(get_latest)"
  else
    local repoName="${repo#*/}"
    local repoOwner="${repo%/*}"
    out="$(gh api graphql -f query='
      query($owner:String!, $name:String!, $tag:String!) {
        repository(owner:$owner, name:$name) {
          asEntered: release(tagName:$tag) { tagName }
          vPrefixed: release(tagName:$tag) { tagName }
        }
      }' -F owner="$repoOwner" -F name="$repoName" -F tag="$want" \
      --jq "[.data.repository.asEntered.tagName, .data.repository.vPrefixed.tagName] | map(select(. != null)) | .[0]")"
  fi
  [[ -n "$out" ]] || die 2 "Unknown version: '${want:-latest}'."
  printf '%s\n' "$out"
}

download() {
  local ver="${1:-}"
  if [[ -z "$ver" || "$ver" == "latest" ]]; then
    ver="$(get_latest)"
  fi
  if [[ -x "$rootdir/dist/$channel/$ver/codeql" ]]; then
    return 0
  fi

  local id
  id="$(gh api 'repos/'"$repo"'/releases' --paginate --jq ".[] | select(.tag_name == \"$ver\") | .id" | head -n1)"
  [[ -n "$id" ]] || die 2 "Version '$ver' not found."

  mkdir -p "$rootdir/dist/$channel"
  local tempdir
  tempdir="$(mktemp -d "$rootdir/dist/$channel/.dl_${ver}.XXXXXXXX")"
  trap 'rm -rf "$tempdir"' EXIT

  log "Downloading CodeQL CLI version $ver..."
  curl -fsSL -o "$tempdir/codeql-$platform.zip" \
    "https://github.com/$repo/releases/download/$ver/codeql-$platform.zip"

  log "Unpacking CodeQL CLI version $ver..."
  unzip -oq "$tempdir/codeql-$platform.zip" -d "$tempdir"
  mv "$tempdir/codeql" "$rootdir/dist/$channel/$ver"

  rm -rf "$tempdir"
  trap - EXIT
}

set_version() {
  local ver; ver="$(validate_version "${1:-latest}")"
  download "$ver"
  gh config set extensions.codeql.version "$ver" 2>/dev/null
}

set_local_version() {
  local ver; ver="$(validate_version "${1:-latest}")"
  download "$ver"
  printf '%s\n' "$ver" > .codeql-version
}

install_stub() {
  local bindir="${1:-/usr/local/bin}"
  [[ -e "$bindir" ]] || die 2 "Directory '$bindir' does not exist."
  local t="$bindir/.codeql.$$"
  (umask 077 && : >"$t") 2>/dev/null || die 13 "Missing write permission on '$bindir'."
  rm -f "$t" || true

  cat <<'STUB' > "$bindir/codeql"
#!/usr/bin/env bash
set -e
exec -a codeql gh codeql "$@"
STUB
  chmod +x "$bindir/codeql"
  log "Stub installed to: $bindir/codeql"
}

# -------- subcommands --------
case "${1:-}" in
  list-versions)
    gh api "repos/$repo/releases" --paginate --jq '.[].tag_name'
    exit 0
    ;;

  set-channel)
    [[ "${2:-}" == "release" || "${2:-}" == "nightly" ]] || die 2 "Invalid channel: '${2:-}'."
    old_channel="$(gh config get extensions.codeql.channel 2>/dev/null || echo release)"
    if [[ "$old_channel" != "$2" ]]; then
      gh config set extensions.codeql.channel "$2" 2>/dev/null
      gh config set extensions.codeql.version "" 2>/dev/null
      log "Switched to $2 channel. Any pinned version has been unset."
    else
      log "Channel already set to $2."
    fi
    exit 0
    ;;

  download)
    download "${2:-latest}"
    exit 0
    ;;

  set-version)
    set_version "${2:-latest}"
    version="$(gh config get extensions.codeql.version 2>/dev/null || true)"
    exec "$rootdir/dist/$channel/$version/codeql" version
    ;;

  set-local-version)
    if [[ "${local_version:-}" == "true" ]]; then
      set_local_version "${2:-latest}"
      version="$(< .codeql-version)"
      exec "$rootdir/dist/$channel/$version/codeql" version
    else
      die 2 "$(cat <<'MSG'
Local version support is disabled by default to prevent untrusted git repositories from forcing older CodeQL CLIs.
Enable it explicitly with: gh codeql local-version on
MSG
)"
    fi
    ;;

  unset-local-version)
    if [[ -e .codeql-version ]]; then rm -f .codeql-version; else warn "No local version specified."; fi
    exit 0
    ;;

  list-installed)
    if [[ -d "$rootdir/dist/$channel" ]]; then
      (cd "$rootdir/dist/$channel" && find . -mindepth 1 -maxdepth 1 -type d -printf '%P\n') || true
    fi
    exit 0
    ;;

  cleanup)
    [[ -n "${2:-}" ]] || die 2 "Version must be specified."
    [[ -d "$rootdir/dist/$channel/$2" ]] || die 2 "Version '$2' not found."
    rm -rf "$rootdir/dist/$channel/$2"
    exit 0
    ;;

  cleanup-all)
    rm -rf "$rootdir/dist"
    exit 0
    ;;

  install-stub)
    install_stub "${2:-/usr/local/bin}"
    exit 0
    ;;
esac

# -------- default path --------
if [[ -z "${version:-}" ]]; then
  set_version latest
  version="$(gh config get extensions.codeql.version 2>/dev/null || true)"
fi
download "$version"
export CODEQL_DIST="$rootdir/dist/$channel/$version"
exec "$rootdir/dist/$channel/$version/codeql" "$@"
